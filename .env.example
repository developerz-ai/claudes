# claudes environment variables — a reference list, not a config file.
#
# claudes reads these variables from your shell's environment, and from
# nowhere else: no .env file is ever read, and this one is not loaded either.
# It exists so the names claudes honours are written down in one place, next
# to the code that reads them.
#
# The router key is NOT an environment variable: `claudes login` reads it from
# the prompt or from the first line of stdin and stores it in the config file.
# It is never taken from the environment or from the command line.
#
# Every value below is empty on purpose: an empty value means "unset", which
# is how claudes treats these variables unless the row's own comment says
# otherwise.

XDG_CONFIG_HOME=  # the base directory the config lives under; defaults to $HOME/.config, and a relative value is ignored
# HOME=  # the fallback base for the config directory; a relative value is ignored, and with no absolute XDG_CONFIG_HOME either the commands that need the config directory refuse with exit 78; claudes doctor reports the config as a FAIL and exits 1, and --version exits 0
# PATH=  # where claudes looks for the claude executable; without claude on it the session does not start (exit 127)
CLAUDES_PREFLIGHT_TIMEOUT_MS=  # how long the router pre-launch check waits, in milliseconds; defaults to 1500, and any other value is ignored
BUN_CONFIG_VERBOSE_FETCH=  # pinned to an empty string in the generated settings; unset by default, and a truthy value refuses the session (exit 64)
ANTHROPIC_BASE_URL=  # the endpoint the session talks to; unset by default, and a value that is not the configured router's origin makes claudes key refuse (exit 64)
HTTP_PROXY=  # the proxy for HTTP requests; pinned to your shell's own value, unset by default and then pinned to an empty string; the pair is pinned as a pair: set one spelling and both get it, set both and each keeps its own value
http_proxy=  # the lowercase spelling of HTTP_PROXY; the pair is pinned as a pair: set one spelling and both get it, set both and each keeps its own value
HTTPS_PROXY=  # the proxy for HTTPS requests; pinned to your shell's own value, unset by default and then pinned to an empty string; the pair is pinned as a pair: set one spelling and both get it, set both and each keeps its own value
https_proxy=  # the lowercase spelling of HTTPS_PROXY; the pair is pinned as a pair: set one spelling and both get it, set both and each keeps its own value
ALL_PROXY=  # the catch-all proxy; pinned to your shell's own value, unset by default and then pinned to an empty string; the pair is pinned as a pair: set one spelling and both get it, set both and each keeps its own value
all_proxy=  # the lowercase spelling of ALL_PROXY; the pair is pinned as a pair: set one spelling and both get it, set both and each keeps its own value
NO_PROXY=  # the hosts that bypass the proxy; the two spellings get one merged list, with the router's own host and the loopback hosts prepended when the router runs on this machine
no_proxy=  # the lowercase spelling of NO_PROXY; it gets the same merged list
NODE_TLS_REJECT_UNAUTHORIZED=  # whether Node accepts a certificate it cannot verify; pinned to your shell's own value, unset by default and then pinned to an empty string
NODE_EXTRA_CA_CERTS=  # the CA bundle Node trusts; pinned to your shell's own value, unset by default and then pinned to an empty string
NODE_USE_ENV_PROXY=  # whether Node's own fetch goes through the proxy variables; pinned to your shell's own value, unset by default and then pinned to an empty string
NODE_OPTIONS=  # Node's own options; pinned to your shell's own value and merged into the key helper's environment, unset by default and then pinned to an empty string
CLAUDE_CODE_CERT_STORE=  # the certificate store Claude Code trusts; pinned to your shell's own value, unset by default and then pinned to an empty string
SSL_CERT_FILE=  # the CA file the OpenSSL clients in the session use; carried over only when your shell sets it, never pinned to an empty string
SSL_CERT_DIR=  # the CA directory the OpenSSL clients in the session use; carried over only when your shell sets it, never pinned to an empty string
CLAUDE_CODE_USE_BEDROCK=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_USE_VERTEX=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_USE_FOUNDRY=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_USE_MANTLE=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_USE_ANTHROPIC_AWS=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_USE_GATEWAY=  # a switch that points Claude Code at another provider; stripped from the session and pinned to an empty string, and claudes key refuses (exit 64) when it is truthy
CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST=  # a host process that manages Claude Code's provider and auth environment; unset by default, and a truthy value refuses the session (exit 64)
CLAUDE_CODE_HOST_AUTH_ENV_VAR=  # the name of the env var holding the host's own credential; unset by default, and any non-empty value refuses the session (exit 64), 0 and false included
CLAUDE_CODE_USE_POWERSHELL_TOOL=  # a known-benign CLAUDE_CODE_USE_ toggle; passed through to the session unchanged and never refused
CLAUDE_CODE_USE_NATIVE_FILE_SEARCH=  # a known-benign CLAUDE_CODE_USE_ toggle; passed through to the session unchanged and never refused
CLAUDE_CODE_USE_COWORK_PLUGINS=  # a known-benign CLAUDE_CODE_USE_ toggle; passed through to the session unchanged and never refused
CLAUDE_CODE_USE_*=  # every other variable under this prefix — neither one of the seven provider switches above nor one of the three known-benign toggles; refused (exit 64) when truthy: the launcher refuses it before the session starts, and claudes key refuses it too
ANTHROPIC_*=  # Anthropic's own credentials and endpoint settings; stripped from the session environment, and the generated settings set the names Claude Code needs to an empty string or to the configured router
CLAUDE_CODE_OAUTH_*=  # a claude.ai OAuth credential; stripped from the session environment
AWS_BEARER_TOKEN_BEDROCK=  # the Bedrock bearer credential; stripped from the session environment
