#!/bin/sh
set -eu

# Never use bunx here: it silently auto-installs the unrelated npm packages
# "biome" and "tsc". Require the pinned devDependencies instead.
for tool in biome tsc; do
  if [ ! -x "node_modules/.bin/$tool" ]; then
    echo "bin/check: node_modules/.bin/$tool not found — run bun install first" >&2
    exit 1
  fi
done

node_modules/.bin/biome check --error-on-warnings .

node_modules/.bin/tsc --noEmit -p tsconfig.json
node_modules/.bin/tsc --noEmit -p tsconfig.build.json

bun test

bun scripts/build.ts

# The shipped file must be directly executable, with the exact shebang.
if [ ! -x dist/claudes.js ]; then
  echo "bin/check: dist/claudes.js is not executable" >&2
  exit 1
fi
shebang="$(head -n 1 dist/claudes.js)"
if [ "$shebang" != "#!/usr/bin/env node" ]; then
  echo "bin/check: dist/claudes.js first line is '$shebang', expected '#!/usr/bin/env node'" >&2
  exit 1
fi

# Version must come from package.json; nothing is hardcoded here.
expected="$(node -p "require('./package.json').version")"
actual="$(./dist/claudes.js --version)"
if [ "$actual" != "$expected" ]; then
  echo "bin/check: ./dist/claudes.js --version printed '$actual', expected '$expected'" >&2
  exit 1
fi

# Bare "login" (no --url) must exit 64: that is the usage error.
rc=0
./dist/claudes.js login 2>/dev/null || rc=$?
if [ "$rc" -ne 64 ]; then
  echo "bin/check: ./dist/claudes.js login exited $rc, expected 64" >&2
  exit 1
fi

# A passthrough with no config behind an empty HOME must exit 78 (EX_CONFIG)
# with the exact remedy, newline-terminated — without touching the network.
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

# "doctor" with no config behind an empty HOME: a real run now, so it must
# exit non-zero and print a FAIL line — in the same env -i isolation as the key
# checks below (no ambient env leaks in). The key-leak guard lives further
# down, against the keyed config: here no key exists in the process, so a
# mar_live_ grep could never match.
rc=0
env -i HOME="$scratch/home" XDG_CONFIG_HOME="$scratch/xdg" PATH="$PATH" \
  ./dist/claudes.js doctor >"$scratch/doctor.out" 2>/dev/null || rc=$?
if [ "$rc" -eq 0 ]; then
  echo "bin/check: ./dist/claudes.js doctor exited 0 with no config, expected non-zero" >&2
  exit 1
fi
grep -q "FAIL" "$scratch/doctor.out" || {
  echo "bin/check: ./dist/claudes.js doctor printed no FAIL line" >&2
  exit 1
}

rc=0
HOME="$scratch/home" XDG_CONFIG_HOME="$scratch/xdg" ./dist/claudes.js some-prompt 2>"$scratch/err" || rc=$?
if [ "$rc" -ne 78 ]; then
  echo "bin/check: ./dist/claudes.js some-prompt exited $rc, expected 78" >&2
  exit 1
fi
expected='no claudes config: run `claudes login --url <router>`'
actual="$(tail -n 1 "$scratch/err")"
if [ "$actual" != "$expected" ]; then
  echo "bin/check: ./dist/claudes.js some-prompt stderr was '$actual', expected '$expected'" >&2
  exit 1
fi
last_byte="$(tail -c 1 "$scratch/err" | od -An -tu1 | tr -d ' \n')"
if [ "$last_byte" != "10" ]; then
  echo "bin/check: the no-config error does not end with a newline (last byte: '$last_byte')" >&2
  exit 1
fi

# The usage error on stderr must end with a newline (byte 10), or the shell
# prompt would land on the error's last line.
last_byte="$(./dist/claudes.js login 2>&1 >/dev/null | tail -c 1 | od -An -tu1 | tr -d ' \n')"
if [ "$last_byte" != "10" ]; then
  echo "bin/check: ./dist/claudes.js login stderr does not end with a newline (last byte: '$last_byte')" >&2
  exit 1
fi

# `claudes key` through the shipped file: stdout must be the config's key bytes
# exactly — no trailing newline — and the exit code must be 0. stdout here is a
# file, not a TTY, so the helper path is the one being exercised. The scratch
# HOME/XDG_CONFIG_HOME hold a hand-written 0700 dir and 0600 config. Every
# invocation below runs under `env -i` with exactly HOME, XDG_CONFIG_HOME and
# PATH: the check must not inherit the caller's CLAUDE_CODE_USE_* (a remote
# Claude Code session exports CLAUDE_CODE_USE_CCR_V2=1, which the key guard
# rightly refuses) or an ambient ANTHROPIC_BASE_URL (a developer shell behind
# a gateway, which differs from the synthetic router).
CHECK_KEY="mar_live_A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6"
mkdir -p "$scratch/keyhome" "$scratch/keyxdg/claudes"
chmod 700 "$scratch/keyxdg/claudes"
cat >"$scratch/keyxdg/claudes/config.json" <<JSON
{
  "version": 1,
  "baseUrl": "https://router.example.test",
  "key": "$CHECK_KEY",
  "tiers": {
    "opus": "claude-opus-5-5",
    "sonnet": "claude-sonnet-5-5",
    "haiku": "claude-haiku-4-5"
  }
}
JSON
chmod 600 "$scratch/keyxdg/claudes/config.json"

# doctor against the KEYED config: a real key is loaded into the process now,
# so this is the leak guard that can actually fail. The synthetic router is
# unreachable, so the run must exit non-zero — and no key bytes may appear on
# either stream. (The config check prints the "mar_live_…" display prefix, so
# the grep requires eight real key characters after the prefix.)
rc=0
env -i HOME="$scratch/keyhome" XDG_CONFIG_HOME="$scratch/keyxdg" PATH="$PATH" \
  ./dist/claudes.js doctor >"$scratch/doctor-keyed.out" 2>&1 || rc=$?
if [ "$rc" -eq 0 ]; then
  echo "bin/check: ./dist/claudes.js doctor exited 0 against an unreachable router, expected non-zero" >&2
  exit 1
fi
if grep -q "mar_live_[A-Za-z0-9_-]\{8\}" "$scratch/doctor-keyed.out"; then
  echo "bin/check: ./dist/claudes.js doctor leaked key bytes" >&2
  exit 1
fi

rc=0
env -i HOME="$scratch/keyhome" XDG_CONFIG_HOME="$scratch/keyxdg" PATH="$PATH" \
  ./dist/claudes.js key >"$scratch/key.out" || rc=$?
if [ "$rc" -ne 0 ]; then
  echo "bin/check: ./dist/claudes.js key exited $rc, expected 0" >&2
  exit 1
fi
expected_key_od="$(printf '%s' "$CHECK_KEY" | od -An -c)"
actual_key_od="$(od -An -c <"$scratch/key.out")"
if [ "$actual_key_od" != "$expected_key_od" ]; then
  echo "bin/check: ./dist/claudes.js key output is not exactly the key bytes (no trailing newline)" >&2
  exit 1
fi

# And the same command under a TTY must refuse: exit 64, no key bytes. The
# util-linux and BSD `script` variants take different arguments, so pick by
# platform; where neither form applies (or `script` is missing), skip with a
# printed reason — the pty tests in the suite cover the same path.
pty_form=""
case "$(uname -s)" in
  Linux) pty_form="util-linux" ;;
  Darwin) pty_form="bsd" ;;
  *) pty_form="" ;;
esac
if [ -z "$pty_form" ]; then
  echo "bin/check: no known script(1) form on $(uname -s); skipping the pty refusal check"
elif ! command -v script >/dev/null 2>&1; then
  echo "bin/check: script(1) not found; skipping the pty refusal check"
else
  rc=0
  if [ "$pty_form" = "util-linux" ]; then
    env -i HOME="$scratch/keyhome" XDG_CONFIG_HOME="$scratch/keyxdg" PATH="$PATH" TERM="${TERM:-dumb}" \
      script -qec "./dist/claudes.js key" /dev/null >"$scratch/key-tty.out" || rc=$?
  else
    env -i HOME="$scratch/keyhome" XDG_CONFIG_HOME="$scratch/keyxdg" PATH="$PATH" TERM="${TERM:-dumb}" \
      script -q /dev/null ./dist/claudes.js key >"$scratch/key-tty.out" || rc=$?
  fi
  if grep -q "mar_live_" "$scratch/key-tty.out"; then
    echo "bin/check: ./dist/claudes.js key under a pty leaked key bytes" >&2
    exit 1
  fi
  if [ "$rc" -ne 64 ]; then
    # The captured output aids diagnosis; the leak check above has already
    # established it contains no key bytes.
    echo "bin/check: ./dist/claudes.js key under a pty exited $rc, expected 64" >&2
    cat "$scratch/key-tty.out" >&2
    exit 1
  fi
fi
